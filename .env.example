# Microsoft Entra tenant and API app registration
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Optional separate public-client app; defaults to ENTRA_CLIENT_ID for local sign-in.
ENTRA_TEST_CLIENT_ID=
# Optional if Expose an API uses a non-default App ID URI (default: api://<ENTRA_CLIENT_ID>).
ENTRA_API_APP_ID_URI=

# Use exactly one server credential:
# For local development only; inject from a secret manager in deployments.
MSAL_CLIENT_SECRET=
# Or use a PEM private key protected by the host and provide its certificate thumbprint.
MSAL_CERTIFICATE_PATH=
MSAL_CERTIFICATE_THUMBPRINT=

# The public MCP endpoint URL must match the URL used by clients.
MCP_PUBLIC_URL=http://127.0.0.1:8000/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8000
# Loopback defaults to device-code sign-in at server startup. Set false to require
# each MCP client to provide its own Entra access token.
MCP_STARTUP_AUTH=true
# Optional scopes; default is read-only.
ENTRA_MCP_SCOPES=Entra.Read

# Include the host and port pattern clients will use.
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
# Browser origins are optional. Keep empty if browser clients are not used.
MCP_ALLOWED_ORIGINS=
